    "CREATE UNIQUE INDEX active_interactions ON records(tenant_id,user_id,namespace)\n        WHERE kind='interaction' AND state='active'",
    "CREATE INDEX event_pages ON records(kind,tenant_id,user_id,namespace,sequence)",
    "CREATE INDEX record_pages ON records(kind,tenant_id,user_id,namespace,created_at,key)",
    "CREATE UNIQUE INDEX run_ids ON records(key) WHERE kind='run'",
    "CREATE UNIQUE INDEX unfinished_sessions ON records(tenant_id,user_id,namespace)\n        WHERE kind='run' AND state IN ('accepted','running','suspended')"
  ],
