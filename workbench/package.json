{
  "name": "drov-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "schema": "openapi-typescript ../docs/reference/openapi-v1.json -o src/schema.d.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "playwright test",
    "format:check": "prettier --check src/main.ts src/client.ts src/style.css tests vite.config.ts playwright.config.ts index.html package.json tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
